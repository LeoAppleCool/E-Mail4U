# Copy this file to ".env" and fill in the values.

# ── Discord ──────────────────────────────────────────────────────────────
# Bot token: https://discord.com/developers/applications → your app → Bot → "Reset Token"
DISCORD_TOKEN=
# ID of your server (enable Developer Mode → right-click the server → "Copy Server ID")
DISCORD_GUILD_ID=
# Optional: user IDs of the bot owners, comma-separated.
# Empty = the owner of the app in the developer portal (or the team owner and admins).
OWNER_IDS=

# ── Cloudflare ───────────────────────────────────────────────────────────
# API token: dashboard → My Profile → API Tokens → "Create Token" → "Create Custom Token"
# Permissions:
#   Account › Workers Scripts        › Edit   (upload the relay worker, workers.dev route)
#   Zone    › Zone                   › Read   (list domains)
#   Zone    › Zone Settings          › Read   (show the Email Routing status)
#   Zone    › Email Routing Rules    › Edit   (create/pause/delete addresses)
# Account resources: your account · Zone resources: "All zones" (or the domains you want to use)
CLOUDFLARE_API_TOKEN=
# Optional – only needed if the token can access more than one account
CLOUDFLARE_ACCOUNT_ID=

# ── Optional ─────────────────────────────────────────────────────────────
# Name of the worker the bot creates in your account
WORKER_NAME=email4u-relay
# Days original mails (.eml) are kept for the "Original" button (0 = don't store them)
MAIL_RETENTION_DAYS=30
# Force the Discord upload limit in MB (empty = automatic by boost level: 20/50/100 MB)
UPLOAD_LIMIT_MB=
# debug | info | warn | error
LOG_LEVEL=info
# Time zone for log timestamps, e.g. Europe/Berlin
TZ=UTC
